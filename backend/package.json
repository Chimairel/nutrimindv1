    "test:acceptance:batch10-rnd-rejection": "tsx scripts/batch10-rnd-rejection-fallback-acceptance.ts",
    "test:acceptance:raw-corpus-lookup": "tsx scripts/raw-corpus-generation-lookup-acceptance.ts",
    "test:acceptance:structured-safety": "tsx scripts/structured-safety-intake-acceptance.ts",
    "test:acceptance:structured-replacement": "tsx scripts/structured-safety-replacement-acceptance.ts",
    "measure:structured-coverage": "tsx scripts/measure-structured-library-coverage.ts",
    "check:phase2-scripts": "tsc --project tsconfig.scripts.json",
    "test:load": "tsx scripts/http-load-smoke.ts",
