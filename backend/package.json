    "usda:curate-panlasang-aliases:dry-run": "tsx scripts/curate-panlasang-usda-aliases.ts",
    "usda:curate-panlasang-aliases:apply": "tsx scripts/curate-panlasang-usda-aliases.ts --apply",
    "enns:derive-locality": "tsx scripts/derive-enns-food-group-locality.ts",
    "enns:locality:dry-run": "tsx scripts/import-enns-food-group-locality.ts",
    "enns:locality:apply": "tsx scripts/import-enns-food-group-locality.ts --apply",
    "test": "tsc --project tests/tsconfig.json && tsx --test tests/*.test.ts",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint src tests scripts --fix"
