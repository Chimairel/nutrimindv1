    "test:acceptance:profile-cycles": "tsx scripts/profile-cycle-adaptation-acceptance.ts",
    "test:acceptance:batch3-catalog": "tsx scripts/batch3-catalog-acceptance.ts",
    "test:acceptance:batch4-preparation": "tsx scripts/batch4-upcoming-preparation-acceptance.ts",
    "test:acceptance:batch5-grocery": "tsx scripts/batch5-progressive-grocery-acceptance.ts",
    "test:acceptance:batch6-swaps": "tsx scripts/batch6-contextual-swap-acceptance.ts",
    "test:acceptance:batch7-outside": "tsx scripts/batch7-outside-capture-acceptance.ts",
    "test:acceptance:batch8-outside-review": "tsx scripts/batch8-outside-review-acceptance.ts",
    "test:acceptance:batch9-observed-corpus": "tsx scripts/batch9-observed-corpus-acceptance.ts",
