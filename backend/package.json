{
  "name": "nutrimind-backend",
  "version": "1.0.0",
  "description": "NutriMind backend server with Express, Prisma, and Gemini",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/rewrite-path-aliases.cjs",
    "start": "node dist/server.js",
    "seed": "tsx prisma/seed.ts",
    "seed:test-accounts": "tsx prisma/seed-test-accounts.ts",
    "seed:meal-library": "tsx prisma/seed-common-meal-library.ts",
    "test:integration:production": "tsx scripts/production-integration-smoke.ts",
    "test:acceptance:library-reuse": "tsx scripts/library-reuse-acceptance.ts",
    "test:acceptance:condition-library": "tsx scripts/condition-library-acceptance.ts",
    "test:acceptance:combined-library-flow": "tsx scripts/combined-library-flow-acceptance.ts",
    "test:load": "tsx scripts/http-load-smoke.ts",
    "preflight:data-integrity": "tsx scripts/production-data-integrity-preflight.ts",
    "plans:revalidation:dry-run": "tsx scripts/enqueue-legacy-plan-revalidation.ts",
    "plans:revalidation:apply": "tsx scripts/enqueue-legacy-plan-revalidation.ts --apply",
    "test": "tsc --project tests/tsconfig.json && tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.11.0",
    "@prisma/client": "^5.14.0",
    "@react-pdf/renderer": "^3.4.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.1.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.10",
    "react": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.17",
    "nodemon": "^3.1.0",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
