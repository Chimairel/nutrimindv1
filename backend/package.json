    "meals:reclassify-panlasang:dry-run": "tsx scripts/reclassify-panlasang-corpus.ts",
    "meals:reclassify-panlasang:apply": "tsx scripts/reclassify-panlasang-corpus.ts --apply",
    "meals:certified-signatures:dry-run": "tsx scripts/backfill-certified-recipe-signatures.ts",
    "meals:certified-signatures:apply": "tsx scripts/backfill-certified-recipe-signatures.ts --apply",
    "meals:reconcile-panlasang-fnri:dry-run": "tsx scripts/reconcile-panlasang-fnri-identities.ts",
    "meals:reconcile-panlasang-fnri:apply": "tsx scripts/reconcile-panlasang-fnri-identities.ts --apply",
    "meals:reconcile-panlasang-library:dry-run": "tsx scripts/reconcile-panlasang-library-ingredient-identities.ts",
    "meals:reconcile-panlasang-library:apply": "tsx scripts/reconcile-panlasang-library-ingredient-identities.ts --apply",
    "meals:audit-panlasang-fnri": "tsx scripts/audit-panlasang-fnri-coverage.ts",
    "meals:curate-panlasang-aliases:dry-run": "tsx scripts/curate-panlasang-fnri-aliases.ts",
    "meals:curate-panlasang-aliases:apply": "tsx scripts/curate-panlasang-fnri-aliases.ts --apply",
    "usda:derive": "node scripts/derive-usda-fdc-catalogue.mjs",
    "usda:import:dry-run": "tsx src/cli/import-usda-fdc-catalogue.ts",
    "usda:import:apply": "tsx src/cli/import-usda-fdc-catalogue.ts --apply",
    "usda:import:production:dry-run": "node dist/cli/import-usda-fdc-catalogue.js",
    "usda:import:production:apply": "node dist/cli/import-usda-fdc-catalogue.js --apply",
    "usda:reconcile-panlasang:dry-run": "tsx scripts/reconcile-panlasang-usda-identities.ts",
