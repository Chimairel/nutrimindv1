  profileSnapshot        Json
  createdAt              DateTime              @default(now())

  @@unique([userId, cycleStartDate])
  @@index([adaptationState, createdAt])
}

model HealthProfileRevision {
  id           String                    @id @default(cuid())
  userId       String
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisionType HealthProfileRevisionType
  snapshot     Json
  createdAt    DateTime                  @default(now())

  @@index([userId, createdAt])
}

model AiUsageEvent {
