model IngredientPriceObservation {
  id                           String                         @id @default(cuid())
  publicationId                String
  publication                  IngredientPricePublication     @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  commodityId                  String
  commodity                    IngredientPriceCommodity       @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  geographyId                  String
  geography                    IngredientPriceGeography       @relation(fields: [geographyId], references: [id], onDelete: Restrict)
  sourceObservationKey         String                         @db.VarChar(240)
  kind                         IngredientPriceObservationKind
  currency                     String                         @default("PHP") @db.Char(3)
  amountMinCentavos            Int
  amountMaxCentavos            Int
  observedFrom                 DateTime
  observedTo                   DateTime
  validFrom                    DateTime?
  validUntil                   DateTime?
  originalCommodityDescription String                         @db.VarChar(240)
  originalSpecification        String?                        @db.VarChar(240)
  originalUnit                 String                         @db.VarChar(80)
  normalizedQuantity           Decimal?                       @db.Decimal(18, 6)
  normalizedUnit               IngredientPriceUnit?
  supersedesObservationId      String?                        @unique
  supersedesObservation        IngredientPriceObservation?    @relation("IngredientPriceObservationSupersession", fields: [supersedesObservationId], references: [id], onDelete: Restrict)
  supersededBy                 IngredientPriceObservation?    @relation("IngredientPriceObservationSupersession")
  createdAt                    DateTime                       @default(now())

  @@unique([publicationId, sourceObservationKey])
  @@index([commodityId, geographyId, observedTo])
  @@index([geographyId, observedTo])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

