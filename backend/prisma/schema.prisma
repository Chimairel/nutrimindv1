/// Authoritative dated identity and mutable lifecycle for one meal-plan cycle.
/// Profile inputs and nutrition targets remain in the separate immutable snapshot.
model MealPlanCycle {
  id                       String                        @id
  userId                   String
  user                     User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planType                 PlanType
  cycleRevision            Int                           @default(1)
  startDate                DateTime
  endDate                  DateTime
  preparationOpensAt       DateTime
  shoppingDeadlineAt       DateTime
  expectedSlotCount        Int
  status                   MealPlanCycleStatus           @default(PREPARING)
  deadlineOutcome          MealPlanCycleDeadlineOutcome?
  readyAt                  DateTime?
  activatedAt              DateTime?
  incompleteAcknowledgedAt DateTime?
  shoppingStartedAt        DateTime?
  supersededAt             DateTime?
  supersededById           String?
  supersededBy             MealPlanCycle?                @relation("MealPlanCycleSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes               MealPlanCycle[]               @relation("MealPlanCycleSupersession")
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt

  mealPlans     MealPlan[]
  groceryList   GroceryList?
  generationJob MealPlanGenerationJob?
  snapshot      MealPlanCycleSnapshot?

  @@unique([userId, planType, startDate, cycleRevision])
  @@index([userId, startDate, endDate, status])
  @@index([shoppingDeadlineAt, status])
  @@index([supersededById])
}

/// Immutable inputs and targets used to generate one plan cycle. Live profile
/// edits never rewrite this record, so active and historical adherence retain
/// the target that was actually in force for that plan.
model MealPlanCycleSnapshot {
  id                      String                    @id @default(cuid())
  planGroupId             String                    @unique
  cycle                   MealPlanCycle             @relation(fields: [planGroupId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileRevision         Int
  safetyRevision          Int
  weightKg                Float
  activityLevel           ActivityLevel
  goal                    Goal
  dailyCalorieTarget      Int
  dailyMacroTargets       Json
  dietaryPreference       DietaryPreference?
  carbPreference          CarbPreference?
  foodCulture             String?
  planningGeographyLevel  ConsumptionGeographyLevel
  planningRegionName      String?
  planningProvinceHucName String?
  mealLocalityPreference  MealLocalityPreference
  shoppingDayGroup        ShoppingDayGroup?
  shoppingDayOfWeek       Int?
  generatedAt             DateTime                  @default(now())

  @@index([userId, generatedAt])
}

