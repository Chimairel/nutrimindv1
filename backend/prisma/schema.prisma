  planGroupId    String?
  cycle          MealPlanCycle?              @relation(fields: [planGroupId], references: [id], onDelete: SetNull)
  attempts       Int                         @default(1)
  lastErrorCode  String?                     @db.VarChar(64)
  progressPct    Int                         @default(0)
  stageCode      String                      @default("QUEUED") @db.VarChar(64)
  stageMessage   String?                     @db.VarChar(180)
  startedAt      DateTime                    @default(now())
