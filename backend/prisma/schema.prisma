datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ═══════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════

enum Role {
  USER
  NUTRITIONIST
  ADMIN
}

enum NutritionistApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  CALL_REQUIRED
  CALL_SCHEDULED
  APPROVED
  REJECTED
  ACTIVATED
}

enum Goal {
  LOSE_WEIGHT
  GAIN_WEIGHT
  MAINTAIN
  BUILD_MUSCLE
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  ACTIVE
  VERY_ACTIVE
}

enum DietaryPreference {
  OMNIVORE
  VEGETARIAN
  VEGAN
  PESCATARIAN
}

enum CarbPreference {
  LOW
  MODERATE
  HIGH
}

enum HealthConditionType {
  DIABETES
  HYPERTENSION
  KIDNEY_DISEASE
  HEART_CONDITION
  PREGNANT
  NONE
}

enum AllergenType {
  SHELLFISH
  NUTS
  DAIRY
  GLUTEN
  EGGS
  NONE
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum MealPlanStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum AIConfidenceFlag {
  SAFE
  CAUTION
  NEEDS_REVIEW
}

enum MealLogSource {
  SYSTEM_GENERATED
  USER_LOGGED
  USER_SWAPPED
  SAFETY_REPLACED
}

enum MealLogDataSource {
  FNRI
  GEMINI_ESTIMATED
  SYSTEM
}

enum MealIngredientDataSource {
  FNRI
  GEMINI_ESTIMATED
}

enum MealLogStatus {
  DONE
  PENDING
  SKIPPED
}

enum NotificationType {
  PLAN_APPROVED
  PLAN_REJECTED
  REVIEW_REQUEST
  ASSIGNMENT
  WEEKLY_CHECKIN
  MEAL_FLAGGED
  FLAG_RESOLVED
}

enum AssignmentStatus {
  PENDING
  ACTIVE
  ENDED
}

enum ShoppingDayGroup {
  WEEKEND // week runs Sunday to Saturday
  WEEKDAY // week runs Monday to Sunday
}

enum PlanType {
  STARTER // one-time bridge plan until first full cycle
  WEEKLY // normal 7-day repeating plan
}

enum SafetyEntryDomain {
  CONDITION
  ALLERGY
  INTOLERANCE
  AVOIDED_INGREDIENT
}

enum SafetyEntryProvenance {
  PREDEFINED
  CUSTOM
  LEGACY_MIGRATION
}

enum SafetyEntrySupportState {
  SUPPORTED
  RECOGNIZED_UNSUPPORTED
  NEEDS_CLARIFICATION
  PENDING_REVIEW
  INVALID
}

// ═══════════════════════════════════════════════════════════════
// TABLES
// ═══════════════════════════════════════════════════════════════

model User {
  id                              String    @id @default(cuid())
  name                            String
  email                           String    @unique
  passwordHash                    String
  role                            Role      @default(USER)
  emailVerified                   Boolean   @default(false)
  emailVerificationToken          String?
  emailVerificationExpiry         DateTime?
  emailVerificationFailedAttempts Int       @default(0)
  emailVerificationLockedUntil    DateTime?
  emailVerificationLastSentAt     DateTime?
  passwordResetToken              String?
  passwordResetExpiry             DateTime?
  tosAccepted                     Boolean   @default(false)
  tosAcceptedAt                   DateTime?
  acceptedTermsVersion            String?
  acceptedPrivacyVersion          String?
  healthDataConsentedAt           DateTime?
  onboardingDone                  Boolean   @default(false)
  image                           String?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
  isSuspended                     Boolean   @default(false)
  suspendedAt                     DateTime?
  suspensionReason                String?   @db.VarChar(240)

  // Relations
  accounts                         Account[]
  sessions                         Session[]
  userProfile                      UserProfile?
  healthConditions                 HealthCondition[]
  allergies                        Allergy[]
  nutritionReport                  NutritionReport?
  nutritionistProfile              NutritionistProfile?      @relation("UserToNutritionistProfile")
  nutritionistVerifications        NutritionistProfile[]     @relation("AdminVerifier")
  mealPlans                        MealPlan[]                @relation("UserMealPlans")
  mealLogs                         MealLog[]
  weightLogs                       WeightLog[]
  dailyNutritionLogs               DailyNutritionLog[]
  groceryLists                     GroceryList[]
  notifications                    Notification[]
  planSwapTrackers                 PlanSwapTracker[]
  mealPlanGenerationJobs           MealPlanGenerationJob[]
  weeklyCheckins                   WeeklyCheckin[]
  healthProfileRevisions           HealthProfileRevision[]
  safetyProfileEntries             SafetyProfileEntry[]
  auditEvents                      AuditEvent[]
  outsideMealPreviews              OutsideMealPreview[]
  waterLogs                        WaterLog[]
  nutritionistApplicationsReviewed NutritionistApplication[] @relation("NutritionistApplicationReviewer")
  nutritionistApplicationInvite    NutritionistApplication?  @relation("NutritionistApplicationInvitee")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  access_token      String? @db.Text
  refresh_token     String? @db.Text
  expires_at        Int?
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  expires      DateTime
}

model UserProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                Int?
  biologicalSex      String? // "MALE" or "FEMALE"
  heightCm           Float?
  weightKg           Float?
  targetWeightKg     Float?
  goal               Goal?
  activityLevel      ActivityLevel?
  dietaryPreference  DietaryPreference?
  carbPreference     CarbPreference?
  foodCulture        String?
  dailyCalorieTarget Int?
  otherConditions    String? // Free-text custom health conditions (e.g., "Gout, Celiac")
  otherAllergies     String? // Free-text custom food allergies (e.g., "Soy, Sesame")
  shoppingDayGroup   ShoppingDayGroup? // Determines weekly plan cycle anchor day
  shoppingDayOfWeek  Int? // 0=Sunday ... 6=Saturday; cycle starts the following day
  lastCheckinAt      DateTime?
  checkinStreak      Int                @default(0)
  updatedAt          DateTime           @updatedAt
}

model HealthCondition {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  condition HealthConditionType
}

model Allergy {
  id       String       @id @default(cuid())
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergen AllergenType

  @@map("Allgy") // Preserves existing table name to avoid data loss during migration
}

model SafetyProfileEntry {
  id              String                  @id @default(cuid())
  userId          String
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain          SafetyEntryDomain
  canonicalCode   String?                 @db.VarChar(64)
  displayName     String                  @db.VarChar(120)
  originalText    String                  @db.VarChar(120)
  normalizedText  String                  @db.VarChar(120)
  provenance      SafetyEntryProvenance
  supportState    SafetyEntrySupportState
  policyReference String                  @db.VarChar(120)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([userId, domain, normalizedText])
  @@index([userId, domain])
  @@index([supportState])
}

model NutritionReport {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedAt       DateTime  @default(now())
  acknowledgedAt    DateTime?
  foodsToAvoid      Json
  foodsToLimit      Json
  foodsRecommended  Json
  drinksGuidance    Json
  generalSummary    String    @db.Text
  basedOnConditions Json
  basedOnAllergies  Json
}

model NutritionistProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation("UserToNutritionistProfile", fields: [userId], references: [id], onDelete: Cascade)
  verifiedByAdminId String?
  verifiedByAdmin   User?     @relation("AdminVerifier", fields: [verifiedByAdminId], references: [id])
  prcLicenseNumber  String    @unique
  prcLicenseExpiry  DateTime
  specialization    String?
  yearsOfExperience Int?
  university        String?
  bio               String?   @db.Text
  isVerified        Boolean   @default(false)
  rating            Float     @default(0)
  totalVerified     Int       @default(0)
  verifiedAt        DateTime?

  // Relations
  mealPlansReviewed   MealPlan[]
  verifiedMeals       MealLibrary[]
  safetyReviewedMeals MealLibrary[]             @relation("MealLibrarySafetyReviewer")
  safetyReviewEvents  MealLibrarySafetyReview[] @relation("MealLibrarySafetyReviewActor")
  submittedFlags      MealLibraryFlag[]         @relation("SubmittedFlags")
  claimedPlans        MealPlan[]                @relation("ClaimedPlans")
  firstApprovedPlans  MealPlan[]                @relation("FirstMealPlanApproval")
}

model NutritionistApplication {
  id                  String                        @id @default(cuid())
  referenceCode       String                        @unique @db.VarChar(32)
  status              NutritionistApplicationStatus @default(SUBMITTED)
  fullName            String                        @db.VarChar(161)
  email               String                        @unique @db.VarChar(254)
  phoneNumber         String                        @db.VarChar(30)
  prcLicenseNumber    String                        @unique @db.VarChar(80)
  prcLicenseExpiry    DateTime
  specialization      String                        @db.VarChar(120)
  yearsOfExperience   Int
  university          String                        @db.VarChar(180)
  professionalBio     String                        @db.Text
  availableCallSlots  Json
  applicantConsentAt  DateTime
  reviewedByAdminId   String?
  reviewedByAdmin     User?                         @relation("NutritionistApplicationReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  scheduledCallAt     DateTime?
  meetingUrl          String?                       @db.VarChar(500)
  adminNotes          String?                       @db.Text
  decisionReason      String?                       @db.VarChar(500)
  reviewedAt          DateTime?
  approvedAt          DateTime?
  invitationTokenHash String?                       @unique @db.VarChar(64)
  invitationExpiresAt DateTime?
  invitationSentAt    DateTime?
  activatedAt         DateTime?
  invitedUserId       String?                       @unique
  invitedUser         User?                         @relation("NutritionistApplicationInvitee", fields: [invitedUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@index([status, createdAt])
  @@index([scheduledCallAt])
}

model FoodItem {
  id        String  @id @default(cuid())
  name      String
  category  String?
  calories  Float
  proteinG  Float
  carbsG    Float
  fatG      Float
  fiber     Float?
  sodium    Float?
  potassium Float?
  calcium   Float?
  iron      Float?
  vitaminA  Float?
  vitaminC  Float?
  vitaminB1 Float?
  vitaminB2 Float?
  niacin    Float?
  water     Float?
  source    String  @default("FNRI")

  // Relations
  aliases            FoodAlias[]
  mealIngredients    MealIngredient[]
  libraryIngredients MealLibraryIngredient[]
}

model FoodAlias {
  id         String   @id @default(cuid())
  foodItemId String
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  alias      String
  createdAt  DateTime @default(now())
}

model MealPlan {
  id                            String               @id @default(cuid())
  planGroupId                   String
  userId                        String
  user                          User                 @relation("UserMealPlans", fields: [userId], references: [id], onDelete: Cascade)
  nutritionistId                String?
  nutritionist                  NutritionistProfile? @relation(fields: [nutritionistId], references: [id])
  libraryMealId                 String?
  libraryMeal                   MealLibrary?         @relation("PlanLibraryMeal", fields: [libraryMealId], references: [id])
  status                        MealPlanStatus       @default(PENDING_REVIEW)
  mealType                      MealType
  mealName                      String
  description                   String?              @db.Text
  calories                      Float
  proteinG                      Float
  carbsG                        Float
  fatG                          Float
  aiConfidenceFlag              AIConfidenceFlag     @default(SAFE)
  planType                      PlanType             @default(WEEKLY)
  nutritionistNote              String?              @db.Text
  scheduledDate                 DateTime
  reviewedAt                    DateTime?
  createdAt                     DateTime             @default(now())
  claimedByNutritionistId       String?
  claimedByNutritionist         NutritionistProfile? @relation("ClaimedPlans", fields: [claimedByNutritionistId], references: [id])
  claimedAt                     DateTime?
  requiresSafetyRevalidation    Boolean              @default(true)
  safetyPolicyVersion           String?              @db.VarChar(64)
  highRiskReviewRequired        Boolean              @default(false)
  reviewApprovalCount           Int                  @default(0)
  firstApprovedByNutritionistId String?
  firstApprovedByNutritionist   NutritionistProfile? @relation("FirstMealPlanApproval", fields: [firstApprovedByNutritionistId], references: [id], onDelete: Restrict)
  firstApprovedAt               DateTime?

  // Relations
  ingredients MealIngredient[]
  mealLogs    MealLog[]
  swapLogs    SwapLog[]
}

model MealLibrary {
  id                             String                            @id @default(cuid())
  verifiedByNutritionistId       String?
  verifiedByNutritionist         NutritionistProfile?              @relation(fields: [verifiedByNutritionistId], references: [id])
  safetyReviewedByNutritionistId String?
  safetyReviewedByNutritionist   NutritionistProfile?              @relation("MealLibrarySafetyReviewer", fields: [safetyReviewedByNutritionistId], references: [id], onDelete: Restrict)
  mealName                       String
  description                    String?                           @db.Text
  mealType                       MealType
  calories                       Float
  proteinG                       Float
  carbsG                         Float
  fatG                           Float
  suitableConditions             Json?
  allergenFree                   Json?
  dietaryTags                    Json?
  usageCount                     Int                               @default(0)
  status                         MealLibraryStatus                 @default(APPROVED)
  safetyEvidenceStatus           MealLibrarySafetyEvidenceStatus   @default(INCOMPLETE)
  safetyEvidenceOrigin           MealLibrarySafetyEvidenceOrigin   @default(NUTRITIONIST_DRAFT)
  conditionDeclarationState      MealLibraryDeclarationState       @default(NOT_REVIEWED)
  allergenDeclarationState       MealLibraryDeclarationState       @default(NOT_REVIEWED)
  crossContactAssessment         MealLibraryCrossContactAssessment @default(NOT_ASSESSED)
  safetyEvidenceRevision         Int                               @default(0)
  certifiedEvidenceRevision      Int?
  safetyPolicyVersion            String?                           @db.VarChar(64)
  safetyReviewedAt               DateTime?
  safetyInvalidatedAt            DateTime?
  safetyInvalidationReason       String?                           @db.VarChar(64)
  addedAt                        DateTime                          @default(now())
  updatedAt                      DateTime                          @default(now()) @updatedAt

  // Relations
  mealPlans          MealPlan[]                     @relation("PlanLibraryMeal")
  flags              MealLibraryFlag[]              @relation("MealFlags")
  ingredients        MealLibraryIngredient[]
  safetyDeclarations MealLibrarySafetyDeclaration[]
  safetyReviews      MealLibrarySafetyReview[]

  @@index([status, safetyEvidenceStatus])
  @@index([safetyReviewedByNutritionistId])
}

model MealLibraryIngredient {
  id             String                         @id @default(cuid())
  mealLibraryId  String
  mealLibrary    MealLibrary                    @relation(fields: [mealLibraryId], references: [id], onDelete: Cascade)
  foodItemId     String?
  foodItem       FoodItem?                      @relation(fields: [foodItemId], references: [id], onDelete: Restrict)
  position       Int
  ingredientName String                         @db.VarChar(180)
  category       String?                        @db.VarChar(80)
  dataSource     MealIngredientDataSource
  quantity       Float?
  unit           String?                        @db.VarChar(32)
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @default(now()) @updatedAt
  declarations   MealLibrarySafetyDeclaration[]

  @@unique([mealLibraryId, position])
  @@index([mealLibraryId])
  @@index([foodItemId])
}

model MealLibrarySafetyDeclaration {
  id                      String                           @id @default(cuid())
  mealLibraryId           String
  mealLibrary             MealLibrary                      @relation(fields: [mealLibraryId], references: [id], onDelete: Cascade)
  mealLibraryIngredientId String?
  mealLibraryIngredient   MealLibraryIngredient?           @relation(fields: [mealLibraryIngredientId], references: [id], onDelete: Restrict)
  declarationType         MealLibrarySafetyDeclarationType
  canonicalKey            String?                          @db.VarChar(64)
  customKey               String?                          @db.VarChar(120)
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @default(now()) @updatedAt

  @@index([mealLibraryId])
  @@index([mealLibraryIngredientId])
}

model MealLibrarySafetyReview {
  id                    String                         @id @default(cuid())
  mealLibraryId         String
  mealLibrary           MealLibrary                    @relation(fields: [mealLibraryId], references: [id], onDelete: Restrict)
  nutritionistProfileId String?
  nutritionistProfile   NutritionistProfile?           @relation("MealLibrarySafetyReviewActor", fields: [nutritionistProfileId], references: [id], onDelete: Restrict)
  outcome               MealLibrarySafetyReviewOutcome
  evidenceRevision      Int
  policyVersion         String?                        @db.VarChar(64)
  reasonCode            String?                        @db.VarChar(64)
  evidenceSnapshot      Json
  createdAt             DateTime                       @default(now())

  @@index([mealLibraryId, createdAt])
  @@index([nutritionistProfileId])
}

model MealIngredient {
  id             String                   @id @default(cuid())
  mealPlanId     String
  mealPlan       MealPlan                 @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  foodItemId     String?
  foodItem       FoodItem?                @relation(fields: [foodItemId], references: [id])
  ingredientName String
  category       String?
  dataSource     MealIngredientDataSource @default(FNRI)
  quantity       Float?
  unit           String?                  @db.VarChar(32)
}

model MealLog {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealPlanId          String?           @unique
  mealPlan            MealPlan?         @relation(fields: [mealPlanId], references: [id], onDelete: SetNull)
  source              MealLogSource
  mealName            String
  calories            Float
  proteinG            Float
  carbsG              Float
  fatG                Float
  dataSource          MealLogDataSource
  status              MealLogStatus     @default(PENDING)
  warningType         String?
  warningShown        Boolean           @default(false)
  warningAcknowledged Boolean           @default(false)
  loggedAt            DateTime          @default(now())
  notes               String?           @db.Text
}

model WeightLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg Float
  loggedAt DateTime @default(now())
  note     String?  @db.Text
}

model DailyNutritionLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logDate        DateTime
  totalCalories  Float
  totalProteinG  Float
  totalCarbsG    Float
  totalFatG      Float
  targetCalories Float
  adherencePct   Float

  @@unique([userId, logDate])
}

model GroceryList {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekLabel   String
  generatedAt DateTime @default(now())

  // Relations
  groceryItems GroceryItem[]
}

model GroceryItem {
  id              String      @id @default(cuid())
  groceryListId   String
  groceryList     GroceryList @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
  ingredientName  String
  category        String?
  isChecked       Boolean     @default(false)
  quantity        Float?
  unit            String?     @db.VarChar(32)
  sourceMealCount Int         @default(1)
  isPantryStaple  Boolean     @default(false)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

enum MealLibraryStatus {
  APPROVED
  FLAGGED
  ARCHIVED
}

enum MealLibrarySafetyEvidenceStatus {
  INCOMPLETE
  COMPLETE
  STALE
}

enum MealLibrarySafetyEvidenceOrigin {
  LEGACY_UNREVIEWED
  NUTRITIONIST_DRAFT
  NUTRITIONIST_REVIEW
}

enum MealLibraryDeclarationState {
  NOT_REVIEWED
  REVIEWED_NONE_DECLARED
  REVIEWED_WITH_DECLARATIONS
}

enum MealLibraryCrossContactAssessment {
  NOT_ASSESSED
  ASSESSED_NO_KNOWN_RISK
  RISK_IDENTIFIED
}

enum MealLibrarySafetyDeclarationType {
  ALLERGEN_PRESENT
  ALLERGEN_REVIEWED_ABSENT
  CONDITION_REVIEWED
}

enum MealLibrarySafetyReviewOutcome {
  DRAFT_CREATED
  CERTIFIED
  INVALIDATED
}

enum FlagStatus {
  PENDING
  RESOLVED_REMOVED
  RESOLVED_KEPT
}

model MealLibraryFlag {
  id                      String              @id @default(cuid())
  mealLibraryId           String
  mealLibrary             MealLibrary         @relation("MealFlags", fields: [mealLibraryId], references: [id], onDelete: Cascade)
  flaggedByNutritionistId String
  flaggedByNutritionist   NutritionistProfile @relation("SubmittedFlags", fields: [flaggedByNutritionistId], references: [id], onDelete: Cascade)
  reason                  String              @db.Text
  status                  FlagStatus          @default(PENDING)
  resolvedAt              DateTime?
  createdAt               DateTime            @default(now())
}

model PlanSwapTracker {
  id          String    @id @default(cuid())
  planGroupId String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  swapsUsed   Int       @default(0)
  updatedAt   DateTime  @updatedAt
  swapLogs    SwapLog[]
}

model MealPlanGenerationJob {
  id             String                      @id @default(cuid())
  userId         String
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  planType       PlanType
  cycleStartDate DateTime
  status         MealPlanGenerationJobStatus @default(GENERATING)
  planGroupId    String?
  attempts       Int                         @default(1)
  lastErrorCode  String?                     @db.VarChar(64)
  progressPct    Int                         @default(0)
  stageCode      String                      @default("QUEUED") @db.VarChar(64)
  stageMessage   String?                     @db.VarChar(180)
  startedAt      DateTime                    @default(now())
  completedAt    DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @default(now()) @updatedAt

  @@unique([userId, planType, cycleStartDate])
  @@index([status, updatedAt])
}

model WeeklyCheckin {
  id                     String                @id @default(cuid())
  userId                 String
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleStartDate         DateTime
  changed                Boolean
  submittedWeightKg      Float?
  submittedGoal          Goal?
  submittedActivityLevel ActivityLevel?
  weightTrendKg          Float?
  averageAdherencePct    Float?
  observationDays        Int                   @default(0)
  adaptationState        WeeklyAdaptationState
  profileSnapshot        Json
  createdAt              DateTime              @default(now())

  @@unique([userId, cycleStartDate])
  @@index([adaptationState, createdAt])
}

model HealthProfileRevision {
  id           String                    @id @default(cuid())
  userId       String
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisionType HealthProfileRevisionType
  snapshot     Json
  createdAt    DateTime                  @default(now())

  @@index([userId, createdAt])
}

model AiUsageEvent {
  id        String        @id @default(cuid())
  provider  String        @db.VarChar(32)
  model     String?       @db.VarChar(80)
  status    AiUsageStatus
  attempts  Int
  latencyMs Int
  errorCode String?       @db.VarChar(64)
  createdAt DateTime      @default(now())

  @@index([createdAt, status])
}

enum MealPlanGenerationJobStatus {
  GENERATING
  COMPLETED
  FAILED
}

enum WeeklyAdaptationState {
  INSUFFICIENT_DATA
  ON_TRACK
  LOW_ADHERENCE
  REVIEW_RECOMMENDED
}

enum HealthProfileRevisionType {
  BODY_DIET_UPDATED
  CONDITIONS_UPDATED
  ALLERGIES_UPDATED
  STRUCTURED_SAFETY_UPDATED
}

enum AiUsageStatus {
  SUCCESS
  FAILED
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String   @db.VarChar(80)
  entityType  String   @db.VarChar(80)
  entityId    String?  @db.VarChar(191)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model OutsideMealPreview {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealName   String    @db.VarChar(180)
  mealType   MealType
  estimate   Json
  warnings   Json
  reasons    Json
  notes      String?   @db.Text
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model WaterLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMl Int
  loggedAt DateTime @default(now())

  @@index([userId, loggedAt])
}

model SwapLog {
  id                  String          @id @default(cuid())
  planSwapTrackerId   String
  planSwapTracker     PlanSwapTracker @relation(fields: [planSwapTrackerId], references: [id], onDelete: Cascade)
  mealPlanId          String
  mealPlan            MealPlan        @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  originalMealName    String
  originalCalories    Float
  newMealName         String
  newCalories         Float
  calorieDelta        Float
  warningShown        Boolean         @default(false)
  warningAcknowledged Boolean         @default(false)
  swappedAt           DateTime        @default(now())
}
