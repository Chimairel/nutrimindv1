model MealPlanGenerationJob {
  id              String                      @id @default(cuid())
  userId          String
  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  planType        PlanType
  cycleStartDate  DateTime
  status          MealPlanGenerationJobStatus @default(GENERATING)
  planGroupId     String?
  cycle           MealPlanCycle?              @relation(fields: [planGroupId], references: [id], onDelete: SetNull)
  attempts        Int                         @default(1)
  lastErrorCode   String?                     @db.VarChar(64)
  nextAttemptAt   DateTime?
  processingToken String?                     @db.VarChar(64)
  progressPct     Int                         @default(0)
  stageCode       String                      @default("QUEUED") @db.VarChar(64)
  stageMessage    String?                     @db.VarChar(180)
  startedAt       DateTime                    @default(now())
  completedAt     DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @default(now()) @updatedAt

  @@unique([userId, planType, cycleStartDate])
  @@unique([planGroupId])
  @@index([status, updatedAt])
  @@index([status, nextAttemptAt])
}

/// One durable admission record per provider attempt. Reservations are counted
/// across app instances before an outbound call, including failed attempts.
model AiQuotaReservation {
  id              String           @id @default(cuid())
  provider        String           @db.VarChar(32)
  model           String           @db.VarChar(80)
  estimatedTokens Int
  operation       AiUsageOperation
  reservedAt      DateTime         @default(now())
  completedAt     DateTime?

  @@index([provider, reservedAt])
  @@index([provider, completedAt, reservedAt])
}

/// Authoritative dated identity and mutable lifecycle for one meal-plan cycle.
/// Profile inputs and nutrition targets remain in the separate immutable snapshot.
model MealPlanCycle {
  id                          String                        @id
  userId                      String
  user                        User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planType                    PlanType
  cycleRevision               Int                           @default(1)
  startDate                   DateTime
  endDate                     DateTime
  preparationOpensAt          DateTime
  shoppingDeadlineAt          DateTime
  preparationPolicyVersion    String                        @default("UPCOMING_PREPARATION_V1") @db.VarChar(64)
  assuranceTier               AssuranceTier                 @default(BASE)
  preparationTriggeredAt      DateTime?
  expectedSlotCount           Int
  status                      MealPlanCycleStatus           @default(PREPARING)
  profileAdaptationState      ProfileCycleAdaptationState   @default(CURRENT)
  requestedProfileRevision    Int?
  requestedSafetyRevision     Int?
  acknowledgedProfileRevision Int?
  pendingProfileChangeKinds   String[]                      @default([])
  deadlineOutcome             MealPlanCycleDeadlineOutcome?
  readyAt                     DateTime?
  activatedAt                 DateTime?
  incompleteAcknowledgedAt    DateTime?
  shoppingStartedAt           DateTime?
  supersededAt                DateTime?
  supersededById              String?
  supersededBy                MealPlanCycle?                @relation("MealPlanCycleSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes                  MealPlanCycle[]               @relation("MealPlanCycleSupersession")
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @default(now()) @updatedAt

  mealPlans     MealPlan[]
  groceryList   GroceryList?
  generationJob MealPlanGenerationJob?
  snapshot      MealPlanCycleSnapshot?

  @@unique([userId, planType, startDate, cycleRevision])
  @@index([userId, startDate, endDate, status])
  @@index([shoppingDeadlineAt, status])
  @@index([userId, profileAdaptationState, startDate])
  @@index([supersededById])
}

/// Immutable profile inputs and calorie target for one plan cycle. The
/// dailyMacroTargets JSON is a derived candidate-total projection that fills
/// as queued meal slots are saved; live profile edits never rewrite inputs.
model MealPlanCycleSnapshot {
  id                       String                    @id @default(cuid())
  planGroupId              String                    @unique
  cycle                    MealPlanCycle             @relation(fields: [planGroupId], references: [id], onDelete: Cascade)
  userId                   String
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileRevision          Int
  safetyRevision           Int
  weightKg                 Float
  activityLevel            ActivityLevel
  goal                     Goal
  dailyCalorieTarget       Int
  dailyMacroTargets        Json
  dietaryPreference        DietaryPreference?
  ricePreference           RicePreference            @default(FLEXIBLE)
  ricePreferenceProvenance RicePreferenceProvenance  @default(DEFAULTED)
  foodCulture              String?
  planningGeographyLevel   ConsumptionGeographyLevel
  planningRegionName       String?
  planningProvinceHucName  String?
  mealLocalityPreference   MealLocalityPreference
  shoppingDayGroup         ShoppingDayGroup?
  shoppingDayOfWeek        Int?
  generatedAt              DateTime                  @default(now())

  @@index([userId, generatedAt])
}

model WeeklyCheckin {
  id                     String                @id @default(cuid())
