model NutritionistWorkCredit {
  id                    String                            @id @default(cuid())
  nutritionistProfileId String
  nutritionistProfile   NutritionistProfile               @relation(fields: [nutritionistProfileId], references: [id], onDelete: Restrict)
  entryType             NutritionistWorkCreditEntryType
  creditKind            NutritionistWorkCreditKind
  sourceActionKey       String                            @unique @db.VarChar(191)
  sourceEntityType      String                            @db.VarChar(80)
  sourceEntityId        String                            @db.VarChar(191)
  sourceOutcome         String                            @db.VarChar(64)
  unitsMillis           Int
  policyVersion         String                            @db.VarChar(64)
  earnedAt              DateTime
  reversesCreditId      String?                           @unique
  reversesCredit        NutritionistWorkCredit?           @relation("WorkCreditReversal", fields: [reversesCreditId], references: [id], onDelete: Restrict)
  reversedByCredit      NutritionistWorkCredit?           @relation("WorkCreditReversal")
  reasonCode            String                            @db.VarChar(64)
  createdAt             DateTime                          @default(now())
  statementLinks        CompensationStatementWorkCredit[]

  @@index([nutritionistProfileId, earnedAt])
  @@index([creditKind, earnedAt])
}

model CompensationPolicy {
  id                    String                   @id @default(cuid())
  version               String                   @unique @db.VarChar(64)
  status                CompensationPolicyStatus @default(DRAFT)
  currency              String                   @db.Char(3)
  baseRetainerMinor     Int
  workloadUnitCapMillis Int
  workloadBands         Json
  effectiveFrom         DateTime
  effectiveUntil        DateTime?
  approvedAt            DateTime?
  createdByAdminId      String?
  createdByAdmin        User?                    @relation("CompensationPolicyCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  approvedByAdminId     String?
  approvedByAdmin       User?                    @relation("CompensationPolicyApprover", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  createdAt             DateTime                 @default(now())
  periods               CompensationPeriod[]

  @@index([createdByAdminId])
  @@index([approvedByAdminId])
}

model CompensationPeriod {
  id              String                   @id @default(cuid())
  policyId        String
  policy          CompensationPolicy       @relation(fields: [policyId], references: [id], onDelete: Restrict)
  periodStart     DateTime
  periodEnd       DateTime
  status          CompensationPeriodStatus @default(OPEN)
  closedAt        DateTime?
  openedByAdminId String?
  openedByAdmin   User?                    @relation("CompensationPeriodOpener", fields: [openedByAdminId], references: [id], onDelete: SetNull)
  closedByAdminId String?
  closedByAdmin   User?                    @relation("CompensationPeriodCloser", fields: [closedByAdminId], references: [id], onDelete: SetNull)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  statements      CompensationStatement[]

  @@unique([policyId, periodStart, periodEnd])
  @@index([status, periodEnd])
  @@index([openedByAdminId])
  @@index([closedByAdminId])
}

model CompensationStatement {
  id                     String                            @id @default(cuid())
  periodId               String
  period                 CompensationPeriod                @relation(fields: [periodId], references: [id], onDelete: Restrict)
  nutritionistProfileId  String
  nutritionistProfile    NutritionistProfile               @relation(fields: [nutritionistProfileId], references: [id], onDelete: Restrict)
  status                 CompensationStatementStatus       @default(DRAFT)
  currency               String                            @db.Char(3)
  creditedUnitsMillis    Int                               @default(0)
  cappedUnitsMillis      Int                               @default(0)
  baseRetainerMinor      Int                               @default(0)
  workloadAllowanceMinor Int                               @default(0)
  adjustmentMinor        Int                               @default(0)
  grossMinor             Int                               @default(0)
  calculatedAt           DateTime?
  preparedByAdminId      String?
  preparedByAdmin        User?                             @relation("CompensationStatementPreparer", fields: [preparedByAdminId], references: [id], onDelete: SetNull)
  reviewedByAdminId      String?
  reviewedByAdmin        User?                             @relation("CompensationStatementReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  reviewedAt             DateTime?
  approvedByAdminId      String?
  approvedByAdmin        User?                             @relation("CompensationStatementApprover", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  approvedAt             DateTime?
  createdAt              DateTime                          @default(now())
  updatedAt              DateTime                          @updatedAt
  workCredits            CompensationStatementWorkCredit[]
  adjustments            CompensationAdjustment[]
  payouts                CompensationPayout[]

  @@unique([periodId, nutritionistProfileId])
  @@index([nutritionistProfileId, status])
  @@index([status, approvedAt])
  @@index([preparedByAdminId])
}

model CompensationStatementWorkCredit {
  id                  String                 @id @default(cuid())
  statementId         String
  statement           CompensationStatement  @relation(fields: [statementId], references: [id], onDelete: Restrict)
  workCreditId        String                 @unique
  workCredit          NutritionistWorkCredit @relation(fields: [workCreditId], references: [id], onDelete: Restrict)
  unitsMillisSnapshot Int
  createdAt           DateTime               @default(now())

  @@index([statementId])
}

model CompensationAdjustment {
  id                String                       @id @default(cuid())
  statementId       String
  statement         CompensationStatement        @relation(fields: [statementId], references: [id], onDelete: Restrict)
  amountMinor       Int
  currency          String                       @db.Char(3)
  reasonCode        String                       @db.VarChar(64)
  note              String?                      @db.VarChar(500)
  idempotencyKey    String                       @unique @db.VarChar(160)
  status            CompensationAdjustmentStatus @default(PENDING)
  createdByAdminId  String?
  createdByAdmin    User?                        @relation("CompensationAdjustmentCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  approvedByAdminId String?
  approvedByAdmin   User?                        @relation("CompensationAdjustmentApprover", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  createdAt         DateTime                     @default(now())
  approvedAt        DateTime?
  rejectedByAdminId String?
  rejectedByAdmin   User?                        @relation("CompensationAdjustmentRejector", fields: [rejectedByAdminId], references: [id], onDelete: SetNull)
  rejectedAt        DateTime?
  rejectionReason   String?                      @db.VarChar(240)

  @@index([statementId, createdAt])
  @@index([status, createdAt])
  @@index([rejectedByAdminId])
}

model CompensationPayout {
  id                 String                    @id @default(cuid())
  statementId        String
  statement          CompensationStatement     @relation(fields: [statementId], references: [id], onDelete: Restrict)
  method             CompensationPayoutMethod  @default(MANUAL_OFF_PLATFORM)
  status             CompensationPayoutStatus  @default(DRAFT)
  amountMinor        Int
  currency           String                    @db.Char(3)
  idempotencyKey     String                    @unique @db.VarChar(160)
  externalReference  String?                   @db.VarChar(191)
  submittedByAdminId String?
  submittedByAdmin   User?                     @relation("CompensationPayoutSubmitter", fields: [submittedByAdminId], references: [id], onDelete: SetNull)
  approvedByAdminId  String?
  approvedByAdmin    User?                     @relation("CompensationPayoutApprover", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  approvedAt         DateTime?
  submittedAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  events             CompensationPayoutEvent[]

  @@index([statementId, status])
  @@index([status, createdAt])
}

model CompensationPayoutEvent {
  id          String                   @id @default(cuid())
  payoutId    String
  payout      CompensationPayout       @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  status      CompensationPayoutStatus
  actorUserId String?
  actorUser   User?                    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  reasonCode  String                   @db.VarChar(64)
  metadata    Json?
  createdAt   DateTime                 @default(now())

  @@index([payoutId, createdAt])
  @@index([actorUserId, createdAt])
}
