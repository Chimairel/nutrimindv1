model User {
  id                              String    @id @default(cuid())
  name                            String
  email                           String    @unique
  passwordHash                    String
  passwordLoginEnabled            Boolean   @default(true)
  role                            Role      @default(USER)
  emailVerified                   Boolean   @default(false)
  emailVerificationToken          String?
  emailVerificationExpiry         DateTime?
  emailVerificationFailedAttempts Int       @default(0)
  emailVerificationLockedUntil    DateTime?
  emailVerificationLastSentAt     DateTime?
  passwordResetToken              String?
  passwordResetExpiry             DateTime?
  tosAccepted                     Boolean   @default(false)
  tosAcceptedAt                   DateTime?
  acceptedTermsVersion            String?
  acceptedPrivacyVersion          String?
  healthDataConsentedAt           DateTime?
  onboardingDone                  Boolean   @default(false)
  image                           String?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
  isSuspended                     Boolean   @default(false)
  suspendedAt                     DateTime?
  suspensionReason                String?   @db.VarChar(240)

  // Relations
  accounts                         Account[]
  sessions                         Session[]
  userProfile                      UserProfile?
  healthConditions                 HealthCondition[]
  allergies                        Allergy[]
  nutritionReport                  NutritionReport?
  nutritionReportVersions          NutritionReportVersion[]
  nutritionistProfile              NutritionistProfile?             @relation("UserToNutritionistProfile")
  nutritionistVerifications        NutritionistProfile[]            @relation("AdminVerifier")
  mealPlans                        MealPlan[]                       @relation("UserMealPlans")
  mealLogs                         MealLog[]
  weightLogs                       WeightLog[]
  dailyNutritionLogs               DailyNutritionLog[]
  groceryLists                     GroceryList[]
  notifications                    Notification[]
  mealPlanGenerationJobs           MealPlanGenerationJob[]
  weeklyCheckins                   WeeklyCheckin[]
  mealPlanCycles                   MealPlanCycle[]
  mealPlanCycleSnapshots           MealPlanCycleSnapshot[]
  healthProfileRevisions           HealthProfileRevision[]
  safetyProfileEntries             SafetyProfileEntry[]
  auditEvents                      AuditEvent[]
  outsideMealPreviews              OutsideMealPreview[]
  outsideMealAiUsage               OutsideMealAiUsage[]
  observedMealSubmissions          ObservedMealSubmission[]
  waterLogs                        WaterLog[]
  nutritionistApplicationsReviewed NutritionistApplication[]        @relation("NutritionistApplicationReviewer")
  nutritionistApplicationInvite    NutritionistApplication?         @relation("NutritionistApplicationInvitee")
  compensationStatementsReviewed   CompensationStatement[]          @relation("CompensationStatementReviewer")
  compensationStatementsApproved   CompensationStatement[]          @relation("CompensationStatementApprover")
  compensationAdjustmentsCreated   CompensationAdjustment[]         @relation("CompensationAdjustmentCreator")
  compensationAdjustmentsApproved  CompensationAdjustment[]         @relation("CompensationAdjustmentApprover")
  compensationPayoutsSubmitted     CompensationPayout[]             @relation("CompensationPayoutSubmitter")
  compensationPayoutsApproved      CompensationPayout[]             @relation("CompensationPayoutApprover")
  compensationPayoutEvents         CompensationPayoutEvent[]
  compensationPoliciesCreated      CompensationPolicy[]             @relation("CompensationPolicyCreator")
  compensationPoliciesApproved     CompensationPolicy[]             @relation("CompensationPolicyApprover")
  compensationPeriodsOpened        CompensationPeriod[]             @relation("CompensationPeriodOpener")
  compensationPeriodsClosed        CompensationPeriod[]             @relation("CompensationPeriodCloser")
  compensationStatementsPrepared   CompensationStatement[]          @relation("CompensationStatementPreparer")
  compensationAdjustmentsRejected  CompensationAdjustment[]         @relation("CompensationAdjustmentRejector")
  referenceDataReleasesCreated     ReferenceDataRelease[]           @relation("ReferenceDataReleaseCreator")
  referenceDataReleasesActivated   ReferenceDataRelease[]           @relation("ReferenceDataReleaseActivator")
  referenceDataActivations         ReferenceDataReleaseActivation[] @relation("ReferenceDataActivationActor")
  foodAliasesVerified              FoodAlias[]                      @relation("FoodAliasAdminVerifier")
  scopedConditionClearances        MealConditionClearance[]         @relation("ConditionClearanceUserScope")
  mealFavorites                    MealFavorite[]
  clinicalProfileReviews           ClinicalProfileReview[]
  clinicalDocuments                ClinicalDocument[]
  clinicalContextResponses         ClinicalContextResponse[]
  clinicalFacts                    ClinicalFact[]
}

// Historical profile-review evidence remains in the database. Current flows
// use the report and meal-review gates, but this model preserves schema parity
// and the account-deletion cascade for existing review records.
enum ClinicalProfileReviewStatus {
  PENDING
  APPROVED
  DECLINED
}

model ClinicalProfileReview {
  id              String                      @id
  userId          String
  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileRevision Int
  policyVersion   String                      @db.VarChar(80)
  status          ClinicalProfileReviewStatus @default(PENDING)
  reasonCodes     Json
  profileSnapshot Json
  reviewerId      String?
  reviewer        NutritionistProfile?        @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewNotes     String?                     @db.VarChar(2000)
  createdAt       DateTime                    @default(now())
  reviewedAt      DateTime?

  @@unique([userId, profileRevision, policyVersion])
  @@index([status, createdAt])
  @@index([reviewerId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  access_token      String? @db.Text
  refresh_token     String? @db.Text
  expires_at        Int?

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  expires      DateTime
}

model NutritionReportVersion {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  version         Int
  profileRevision Int
  generatedAt     DateTime  @default(now())
  acknowledgedAt  DateTime?
  content         Json
  profileSnapshot Json
  policyVersion   String    @default("NUTRIMIND_REPORT_V2")

  @@unique([userId, version])
}

model UserProfile {
  revision                 Int                       @default(0)
  safetyRevision           Int                       @default(0)
  id                       String                    @id @default(cuid())
  userId                   String                    @unique
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                      Int?
  biologicalSex            String? // "MALE" or "FEMALE"
  heightCm                 Float?
  weightKg                 Float?
  targetWeightKg           Float?
  goal                     Goal?
  activityLevel            ActivityLevel?
  dietaryPreference        DietaryPreference?
  ricePreference           RicePreference            @default(FLEXIBLE)
  ricePreferenceProvenance RicePreferenceProvenance  @default(DEFAULTED)
  foodCulture              String?
  planningGeographyLevel   ConsumptionGeographyLevel @default(NATIONAL)
  planningRegionName       String?                   @db.VarChar(120)
  planningProvinceHucName  String?                   @db.VarChar(160)
  mealLocalityPreference   MealLocalityPreference    @default(NATIONAL)
  dailyCalorieTarget       Int?
  otherConditions          String? // Free-text custom health conditions (e.g., "Gout, Celiac")
  otherAllergies           String? // Free-text custom food allergies (e.g., "Soy, Sesame")
  shoppingDayGroup         ShoppingDayGroup? // Determines weekly plan cycle anchor day
  shoppingDayOfWeek        Int? // 0=Sunday ... 6=Saturday; cycle starts the following day
  lastCheckinAt            DateTime?
  checkinStreak            Int                       @default(0)
  updatedAt                DateTime                  @updatedAt
}

model HealthCondition {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  condition HealthConditionType
}

model Allergy {
  id       String       @id @default(cuid())
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergen AllergenType

  @@map("Allgy") // Preserves existing table name to avoid data loss during migration
}

model SafetyProfileEntry {
  id              String                  @id @default(cuid())
  userId          String
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain          SafetyEntryDomain
  canonicalCode   String?                 @db.VarChar(64)
  displayName     String                  @db.VarChar(120)
  originalText    String                  @db.VarChar(120)
  normalizedText  String                  @db.VarChar(120)
  provenance      SafetyEntryProvenance
  supportState    SafetyEntrySupportState
  policyReference String                  @db.VarChar(120)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([userId, domain, normalizedText])
  @@index([userId, domain])
  @@index([supportState])
}

model NutritionReport {
  profileRevision   Int       @default(0)
  isStale           Boolean   @default(false)
  version           Int       @default(1)
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedAt       DateTime  @default(now())
  acknowledgedAt    DateTime?
  foodsToAvoid      Json
  foodsToLimit      Json
  foodsRecommended  Json
  drinksGuidance    Json
  generalSummary    String    @db.Text
  basedOnConditions Json
  basedOnAllergies  Json
}

model NutritionistProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation("UserToNutritionistProfile", fields: [userId], references: [id], onDelete: Cascade)
  verifiedByAdminId   String?
  verifiedByAdmin     User?     @relation("AdminVerifier", fields: [verifiedByAdminId], references: [id])
  prcLicenseNumber    String    @unique
  prcLicenseExpiry    DateTime
  specialization      String?
  yearsOfExperience   Int?
  university          String?
  bio                 String?   @db.Text
  isVerified          Boolean   @default(false)
  officialHeadshot    String?   @db.Text
  digitalSignature    String?   @db.Text
  payoutChannel       String?   @db.VarChar(30)
  payoutAccountName   String?   @db.VarChar(120)
  payoutAccountNumber String?   @db.VarChar(50)
  payoutBankName      String?   @db.VarChar(80)
  rating              Float     @default(0)
  totalVerified       Int       @default(0)
  verifiedAt          DateTime?
  canLeadReview       Boolean   @default(false)

  // Relations
  mealPlansReviewed        MealPlan[]
  verifiedMeals            MealLibrary[]
  safetyReviewedMeals      MealLibrary[]                    @relation("MealLibrarySafetyReviewer")
  safetyReviewEvents       MealLibrarySafetyReview[]        @relation("MealLibrarySafetyReviewActor")
  submittedFlags           MealLibraryFlag[]                @relation("SubmittedFlags")
  claimedPlans             MealPlan[]                       @relation("ClaimedPlans")
  firstApprovedPlans       MealPlan[]                       @relation("FirstMealPlanApproval")
  workCredits              NutritionistWorkCredit[]
  compensationStatements   CompensationStatement[]
  outsideMealReviews       OutsideMealReview[]              @relation("OutsideMealReviewAssignee")
  outsideMealRevisions     OutsideMealItemRevision[]        @relation("OutsideMealRevisionReviewer")
  approvedNutrientRules    ConditionNutrientRule[]          @relation("ConditionNutrientRuleApprover")
  approvedIngredientRules  ConditionIngredientRule[]        @relation("ConditionIngredientRuleApprover")
  clearanceDecisions       MealConditionClearanceDecision[]
  mealPlanReviewDecisions  MealPlanReviewDecision[]
  conditionRuleApprovals   ConditionRulePolicyApproval[]
  resolvedClearances       MealConditionClearance[]         @relation("ConditionClearanceResolver")
