# Dependencies
**/node_modules/

# Next.js build outputs
**/.next/
**/.next-production/
**/.next-corrupt-*/
**/out/

# Backend build outputs
**/dist/
**/coverage/
**/playwright-report/
**/test-results/

# Local Environment Secrets (CRITICAL)
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
/deploy/.env.railway.local
/deploy/.env.vercel.local

# Logs and OS files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
*.tsbuildinfo
**/next-env.d.ts
**/.env.runtime-test.local

# Local files that do not belong in the application repository
codex/Install VALORANT.exe
codex/toothless.jpg
# Isolated disposable browser acceptance output
/frontend/.next-repair/

# FNRI public-use respondent records are kept locally and reduced to committed aggregates.
/backend/data/enns/*/source-delivery/
/backend/data/usda/source-delivery/

# Local rollback snapshots from recipe data audit scripts.
/backend/.data-audit-backups/
/.data-audit-backups/

# Local synthetic account credentials (never commit).
/backend/.local/dev-test-accounts/

# Private shared-database rollback snapshots (never commit).
/backend/.local/backups/

# Task-local meal audit verification artifacts.
/backend/.local/meal-log-audit-*

# Local development database credentials and target-switch rollback configuration.
/backend/.local/local-development/
