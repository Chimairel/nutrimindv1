# NutriMind frontend environment template
# Copy this file to .env.local, then fill in any blank values.
# Never put private secrets in NEXT_PUBLIC_* variables; they are visible in the browser.

# Backend REST API base URL. The application also uses this value as its default.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Required only for Google Sign-In.
# Use the same OAuth Web Client ID as backend GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
